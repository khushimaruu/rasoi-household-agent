# Neon: use the POOLED connection string from the Neon dashboard (host contains "-pooler")
DATABASE_URL=
# LLM (optional: without a key Rasoi falls back to deterministic ranking + regex voice parsing)
ANTHROPIC_API_KEY=
LLM_MODEL=

# Integrations: true = use built-in mocks that persist their "external" state in Neon
USE_MOCKS=true
PINELABS_BASE_URL=
PINELABS_CLIENT_ID=
PINELABS_CLIENT_SECRET=
PINELABS_TOKEN_PATH=
PINELABS_ORDERS_PATH=
DELHIVERY_BASE_URL=
DELHIVERY_TOKEN=
GNANI_STT_URL=
GNANI_API_KEY=
GNANI_AUTH_HEADER=
GNANI_AUTH_SCHEME=

# Agent behaviour
PLAN_DAYS_AHEAD=1     # plan tomorrow's meal
STEP_DELAY=0.7        # seconds between steps so the dashboard is watchable
STALE_HOURS=72
NOTIFY_CHANNELS=dashboard,email
# Use your computer's LAN IP for phones on the same Wi-Fi, or a public tunnel URL for off-network access.
PUBLIC_BASE_URL=http://localhost:8000
APP_SECRET=
GMAIL_USER=
GMAIL_APP_PASSWORD=
NOTIFY_EMAIL_TO=
